# Local development with docker-compose.local.yml. Copy to .env.local (ignored by git).
# Every value here is a safe local placeholder: never put real secrets or shared hosts in it.
# Commands you run on the host (scripts/test.sh, manage.py) read .env instead.

SECRET_KEY=local-only-not-a-secret-change-nothing-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
LOGGER_DIR_PATH=/var/log/mulearnbackend
LOG_LEVEL=INFO

# The mysql service, built from schema/latest.sql on its first start.
DATABASE_ENGINE=django.db.backends.mysql
DATABASE_HOST=mysql
DATABASE_PORT=3306
DATABASE_NAME=mulearn
DATABASE_USER=root
DATABASE_PASSWORD=local-only

# Cache, Channels and the Celery broker share one Redis today (see docker-compose.local.yml).
REDIS_HOST=redis-state
REDIS_PORT=6379

# Must match the id seeded by scripts/seed-system-user.sql.
SYSTEM_ADMIN_ID=00000000-0000-4000-8000-000000000001

# Email is printed to the container log, never sent.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_HOST_USER=local
EMAIL_HOST_PASSWORD=local-only
EMAIL_PORT=1025
EMAIL_USE_TLS=False
FROM_MAIL=noreply@mulearn.local

FR_DOMAIN_NAME=http://localhost:3000
BE_DOMAIN_NAME=http://localhost:8000
AUTH_DOMAIN=http://localhost:8001
LAUNCHPAD_FR_DOMAIN_NAME=http://localhost:3000
LAUNCHPAD_ADMIN_EMAIL=admin@mulearn.local
R2_PUBLIC_BASE_URL=http://localhost:8000/media

# External services: dummy values, so nothing reaches a real service.
PROTECTED_API_KEY=local-only
BACKEND_API_KEY=local-only
AARON_CHETTAN_IP=127.0.0.1
DISCORD_WEBHOOK_LINK=
DISCORD_CLIENT_ID=local-only
DISCORD_CLIENT_SECRET=local-only
DISCORD_GUILD_ID=0
DISCORD_BOT_TOKEN=local-only
WADHWANI_CLIENT_AUTH_URL=http://localhost:9999
WADHWANI_BASE_URL=http://localhost:9999
WADHWANI_CLIENT_SECRET=local-only
RAZORPAY_ID=local-only
RAZORPAY_SECRET=local-only
QSEVERSE_BASE_URL=http://localhost:9999
QSEVERSE_API_KEY=local-only

NOTIFICATION_DISPATCH_MODE=inline
NOTIFICATION_BROADCAST_THRESHOLD=500
NOTIFICATION_UNREAD_COUNT_CACHE_TTL=60
ENABLE_SWAGGER=True
FIREBASE_CREDENTIALS=
PUSH_ENABLED=False
