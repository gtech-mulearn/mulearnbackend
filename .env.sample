# local (the default), dev, staging or production: decides which settings are required
# (mulearnbackend/config_settings.py). Check a file with: python manage.py config_check --env-file <path>
# MULEARN_ENV=local
SECRET_KEY=SEDKLK23D@LK323#@!2
DEBUG=True
ALLOWED_HOSTS=*
LOGGER_DIR_PATH=./logs
# While this file exists, /healthz/ready returns 503 so the load balancer drains the node.
# DRAIN_FLAG_PATH=/tmp/mulearn-drain
# Level for root.log (the catch-all logger). Defaults to WARNING when unset; use
# INFO or DEBUG only while investigating something, since every line is a
# synchronous file write on the request path.
LOG_LEVEL=WARNING
# text (the default) or json: one JSON object per line, with the request id, secrets redacted.
LOG_FORMAT=text

DATABASE_ENGINE=django.db.backends.mysql
DATABASE_USER=root
DATABASE_PASSWORD=admin
DATABASE_NAME=bot
DATABASE_HOST=localhost
DATABASE_PORT=3306

REDIS_HOST=localhost
REDIS_PORT=6379

DISCORD_WEBHOOK_LINK=

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_HOST_USER=hey@gmail.com
EMAIL_HOST_PASSWORD=xxxxxxxx
EMAIL_PORT=587
EMAIL_USE_TLS=True
FROM_MAIL =
PROTECTED_API_KEY=
FR_DOMAIN_NAME=http://127.0.0.1:8000
BE_DOMAIN_NAME = http://127.0.0.1:8000
AUTH_DOMAIN=http://127.0.0.1:8000

WADHWANI_CLIENT_AUTH_URL=
WADHWANI_BASE_URL=
WADHWANI_CLIENT_SECRET=

RAZORPAY_ID=
RAZORPAY_SECRET=

PROTECTED_API_KEY =

SYSTEM_ADMIN_ID =

LAUNCHPAD_ADMIN_EMAIL = 

DISCORD_CLIENT_ID=xxx
DISCORD_CLIENT_SECRET=xxx
DISCORD_GUILD_ID=xxx
DISCORD_BOT_TOKEN=xxx

