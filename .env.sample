# Optional � all default in settings.py if omitted.
NOTIFICATION_DISPATCH_MODE=inline
NOTIFICATION_BROADCAST_THRESHOLD=500
NOTIFICATION_UNREAD_COUNT_CACHE_TTL=60

ENABLE_SWAGGER=

# Required. Public base URL of the R2 bucket (images are uploaded by the media worker),
# e.g. https://media.example.org
R2_PUBLIC_BASE_URL=
# Push notifications (docs/push-notifications.md). Service-account JSON or a path to it; empty disables push.
FIREBASE_CREDENTIALS=
PUSH_ENABLED=True
# Which beat schedules this deployment registers: all (the default), none, or a
# comma-separated list of names from CELERY_BEAT_SCHEDULE in mulearnbackend/settings.py.
# BEAT_SCHEDULES=all
