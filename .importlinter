# Generated by scripts/gen_importlinter.py from tests/architecture/module_graph.toml.
# Don't edit it: change the graph, run python scripts/gen_importlinter.py, and commit both.

[importlinter]
root_packages =
    building_blocks
    modules
    api
    db
    utils
    mu_celery
# Forbidden contracts may name packages that aren't installed or don't exist yet.
include_external_packages = True

[importlinter:contract:building-blocks]
name = building_blocks imports no business or legacy code
type = forbidden
source_modules =
    building_blocks
forbidden_modules =
    modules
    api
    db
    utils
    mu_celery

[importlinter:contract:legacy-uses-public-surfaces]
name = legacy code imports only modules.*.public, modules.*.contracts and building_blocks
type = forbidden
source_modules =
    api
    db
    utils
    mu_celery
forbidden_modules =
    modules
ignore_imports =
    api.** -> modules.*.public
    api.** -> modules.*.contracts
    db.** -> modules.*.public
    db.** -> modules.*.contracts
    utils.** -> modules.*.public
    utils.** -> modules.*.contracts
    mu_celery.** -> modules.*.public
    mu_celery.** -> modules.*.contracts
allow_indirect_imports = True
unmatched_ignore_imports_alerting = none
